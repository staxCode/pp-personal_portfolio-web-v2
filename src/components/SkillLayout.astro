---
import Button from './Button.astro'
import { getSkillIcon, getSkillColor } from '../utils/skillIcons'
const { title, skills, i18nKey } = Astro.props
---

<div class='flex flex-col gap-y-2 md:flex-row md:gap-x-5 md:gap-y-0'>
	<h3 class='w-1/5 font-medium' {...(i18nKey && { 'data-i18n': i18nKey })}>{title}</h3>
	<div class='flex w-4/5 flex-row flex-wrap gap-x-4 gap-y-2'>
		{skills.map((skill: string) => <Button as='button' title={skill} style='pill' iconName={getSkillIcon(skill)} iconColor={getSkillColor(skill)} />)}
	</div>
</div>
