---
const { description, i18nKey } = Astro.props
---

<div class='flex flex-col items-center'>
	<div class='intro-container'>
		<h1 class='text-2xl'>
			<span {...(i18nKey && { 'data-i18n': i18nKey })}>{description}</span>
			<span class='ml-1 font-bold'>
				<span id='animated-word'></span><span class='caret'>|</span>
			</span>
		</h1>
	</div>
</div>

<script>
	let typingWords: Array<{text: string, color: string}> = []

	async function loadTypingWords(lang: string): Promise<void> {
		const file = lang === 'en' ? './data/typingEffectData.en.json' : './data/typingEffectData.es.json'
		try {
			const data = await fetch(file)
			const _words = await data.json()
			typingWords = _words.areasIT
		} catch {
			typingWords = []
		}
	}

	let wordIndex = 0
	let charIndex = 0
	let isDeleting = false

	const wordEl = document.getElementById('animated-word')
	const typingSpeed = 100
	const pauseBetweenWords = 1500
	let typingTimeout: ReturnType<typeof setTimeout> | null = null

	function resetTyping() {
		wordIndex = 0
		charIndex = 0
		isDeleting = false
		if (typingTimeout) clearTimeout(typingTimeout)
		if (wordEl) wordEl.textContent = ''
	}

	function type() {
		if (typingWords.length === 0) return

		const currentWord = typingWords[wordIndex]

		if (isDeleting) {
			charIndex--
			if (wordEl) {
				wordEl.textContent = currentWord.text.substring(0, charIndex)
			}
			if (charIndex === 0) {
				isDeleting = false
				wordIndex = (wordIndex + 1) % typingWords.length
				typingTimeout = setTimeout(type, 500)
				return
			}
		} else {
			charIndex++
			if (wordEl) {
				wordEl.textContent = currentWord.text.substring(0, charIndex)
				wordEl.style.color = currentWord.color
			}
			if (charIndex === currentWord.text.length) {
				isDeleting = true
				typingTimeout = setTimeout(type, pauseBetweenWords)
				return
			}
		}

		typingTimeout = setTimeout(type, isDeleting ? 50 : typingSpeed)
	}

	async function startTyping(lang: string): Promise<void> {
		resetTyping()
		await loadTypingWords(lang)
		type()
	}

	const currentLang = localStorage.getItem('language') || 'es'
	startTyping(currentLang)

	document.addEventListener('language-change', (e: Event) => {
		startTyping((e as CustomEvent).detail.language)
	})
</script>

<style>
	.caret {
		display: inline-block;
		margin-left: 2px;
		color: rgb(139, 139, 139);
		animation: blink-caret 0.7s step-end infinite;
	}

	@keyframes blink-caret {
		0%,
		100% {
			opacity: 0;
		}
		50% {
			opacity: 1;
		}
	}
</style>
