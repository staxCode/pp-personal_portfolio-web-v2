---
import { Icon } from 'astro-icon/components'
import { cn } from '@/utils'
const { as: Tag = 'a', class: className, title, href, style = 'button', iconName, iconColor } = Astro.props
---

<Tag
	class={cn(
		className,
		'group inline-flex items-center gap-x-1 rounded-lg bg-primary-foreground border border-border px-2 py-1 text-sm transition-all hover:bg-input',
		!href && 'cursor-default',
		style === 'pill' && 'rounded-xl'
	)}
	href={href}
	data-astro-prefetch
>
	{iconName && (
		<span class='overflow-hidden w-0 transition-all group-hover:w-[1em]' style={`color: ${iconColor}`}>
			<Icon name={iconName} class='h-[1em] w-[1em] shrink-0' />
		</span>
	)}
	<slot name='icon-before' />
	<p>{title}</p>
	<slot name='icon-after' />
</Tag>
